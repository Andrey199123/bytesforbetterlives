{
  "outputDirectory": "public",
  "github": {
    "enabled": false
  },
  "git": {
    "deploymentEnabled": false
  },
  "headers": [
    {
      "source": "/(styles\\.css|script\\.js|data\\.js|firebase-data\\.js)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
