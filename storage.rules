rules_version = '2';

// Bytes for Better Lives — Storage security rules.
// Deploy: npx firebase deploy --only storage (firebase.json wires this file).
//
// Model: uploaded images are publicly readable; only listed admins can upload/delete.
// This list = full admins + any chapter admin who needs to upload files. Keep the FULL-admin
// entries in sync with firebase.js ADMIN_EMAILS and firestore.rules; add chapter-admin emails
// here too if they should be able to upload photos (Storage rules can't read the chapterAdmins map).

service firebase.storage {
  match /b/{bucket}/o {

    function canUpload() {
      return request.auth != null
        && request.auth.token.email in [
          "bytesforbetterlives@gmail.com",
          "petr1264k@gmail.com",
          "lakeqiao3805@gmail.com"
        ];
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if canUpload()
        && request.resource.size < 10 * 1024 * 1024            // max 10 MB
        && request.resource.contentType.matches('image/.*');   // images only
    }
  }
}
